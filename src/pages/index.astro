---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ProjectList from '../components/ProjectList.astro';
import home from '../data/home.json';
import { withVersion } from '../data/projects';
import { existsSync } from 'node:fs';

// Showreel, its still frame and label are edited in /admin/ (Homepage).
// A Cloudflare video there wins over the uploaded MP4: the build copies it
// to /video/stream/reel.mp4 with its first frame (scripts/stream-reel.sh).
const fromStream = existsSync('public/video/stream/reel.mp4');
const reel = withVersion(fromStream ? '/video/stream/reel.mp4' : home.reel);
const poster = withVersion(fromStream && existsSync('public/video/stream/reel.jpg') ? '/video/stream/reel.jpg' : home.poster);
---

<Base theme="dark">
  <link slot="head" rel="preload" href={poster} as="image" />
  <main class="hero grid">
    <div class="stage" aria-hidden="true" style={`background-image: url("${poster}")`}>
      <!-- The reel is used as exported, no re-encoding. It stays invisible
           (the still behind it shows) until it is actually playing, so
           Safari's own play button never flashes up while it loads. -->
      <video class="reel" poster={poster} autoplay muted loop playsinline preload="auto">
        <source src={reel} type="video/mp4" />
      </video>
      <div class="previews"></div>
    </div>

    <Header current="works" />

    <p class="reel-label">{home.label}</p>

    <!-- The same element as the list on every project page. -->
    <ProjectList class="menu" previews />
  </main>
</Base>

<style>
  /*
   * The hero is the page grid with three rows: header, open space, and the
   * bottom line with "Showreel 2025". The menu fills the right-hand columns
   * from the bottom up, level with the showreel label.
   *
   * All homepage text (header, menu, showreel label) is SF Pro Display, 9.45
   * design px on 10.7 (see --rm in global.css), so it scales with the window
   * like Readymag. The header and the menu are the same as on every project
   * page, so they don't move when you switch pages.
   */
  .hero {
    /* 15px on 17px on alona's 14" MacBook, like the project pages. */
    --text: calc(9.45 * var(--rm));
    --line: calc(10.7 * var(--rm));
    --tracking: -0.06em;
    font-family: var(--font-sans);
    font-size: var(--text);
    line-height: var(--line);
    position: relative;
    height: 100vh;
    height: 100svh;
    grid-template-rows: auto minmax(0, 1fr) auto;
    row-gap: var(--top);
    padding-block: var(--top) var(--margin);
    overflow: hidden;
  }

  .stage {
    position: absolute;
    inset: 0;
    background: #000 center / cover no-repeat;
  }
  .stage .reel {
    opacity: 0;
    transition: opacity 200ms linear;
  }
  .stage .reel.playing {
    opacity: 1;
  }
  .stage :global(video),
  .stage :global(.preview),
  .stage :global(.preview img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stage :global(.preview) {
    opacity: 0;
    transition: opacity 120ms linear;
  }
  .stage :global(.preview.on) {
    opacity: 1;
  }
  /* Until its clip plays, a preview shows only the thumbnail underneath. */
  .stage :global(.preview:not(.ready) :is(video, .video-canvas)) {
    visibility: hidden;
  }

  /* Logo and menu take the same difference blend as the project list. */
  .hero :global(.header) {
    color: #fff;
    mix-blend-mode: difference;
  }

  .reel-label {
    grid-row: 3;
    grid-column: 1 / 9;
    align-self: end;
    position: relative;
    margin: 0;
    line-height: 1;
    color: #fff;
    mix-blend-mode: difference; /* same as the logo and menu */
  }

  /*
   * The project list (src/components/ProjectList.astro): the same element,
   * size and place as on every project page, anchored bottom right.
   */
  .hero :global(.menu) {
    grid-row: 2 / 4;
    grid-column: 13 / -1;
    align-self: end;
    justify-self: end;
    max-height: 100%;
    position: relative;
    mix-blend-mode: difference;
  }

  /*
   * Phone: the showreel stays fixed behind the page and the menu scrolls up
   * over it, starting just below the middle of the first screen. Taps open the
   * project straight away (there are no hover previews on touch screens).
   */
  @media (max-width: 767px) {
    .hero {
      /* Phones keep 10px text: the desktop size would be too small to read. */
      --text: 10px;
      --line: 12px;
      --tracking: -0.06em;
      height: auto;
      min-height: 100svh;
      grid-template-rows: auto auto;
      overflow: visible;
    }
    .stage {
      position: fixed;
    }
    .reel-label {
      position: absolute;
      left: var(--margin);
      top: calc(100svh - var(--margin) - 1em);
    }
    .hero :global(.menu) {
      grid-row: 2;
      grid-column: 8 / -1;
      max-height: none;
      margin-top: 40svh;
      padding-bottom: 48px;
    }
  }
</style>

<script>
  import { coverWithCanvas } from '../scripts/video-canvas';

  // Hover previews. Each menu link carries its clip's URL in data-preview.
  // Clips are created lazily: one after another once the showreel is playing,
  // or immediately when a link is hovered before its turn comes.
  const stage = document.querySelector<HTMLElement>('.previews')!;
  const reel = document.querySelector<HTMLVideoElement>('.reel')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-preview]')];
  const clips = new Map<string, HTMLVideoElement>();
  coverWithCanvas(reel);
  const showReel = () => reel.classList.add('playing');
  if (!reel.paused && reel.readyState > 2) showReel();
  else reel.addEventListener('playing', showReel, { once: true });
  let hovered: HTMLVideoElement | null = null;

  // Some browsers (Safari in Low Power Mode, some embedded viewers) block
  // autoplay. If so, start the showreel on the visitor's first interaction.
  reel.play().catch(() => {
    const kick = () => reel.play().catch(() => {});
    for (const ev of ['pointerdown', 'pointermove', 'keydown', 'touchstart', 'scroll'])
      addEventListener(ev, kick, { once: true, passive: true });
  });

  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  function clipFor(src: string, thumb?: string) {
    let v = clips.get(src);
    if (!v) {
      // Each clip sits in its own box, so the box (clip plus Safari's
      // canvas, see video-canvas.ts) fades in and out as one.
      const box = document.createElement('div');
      box.className = 'preview';
      v = document.createElement('video');
      v.muted = true;
      v.loop = true;
      v.playsInline = true;
      v.preload = 'auto';
      v.src = src;
      // The project's thumbnail sits under the clip, so a hover before the
      // clip has loaded shows the thumbnail instead of nothing.
      if (thumb) {
        const img = new Image();
        img.alt = '';
        img.decoding = 'async';
        img.src = thumb;
        box.append(img);
      }
      box.append(v);
      stage.append(box);
      coverWithCanvas(v);
      clips.set(src, v);
    }
    return v;
  }

  function show(v: HTMLVideoElement) {
    for (const other of clips.values()) if (other !== v) hide(other);
    hovered = v;
    // The clip itself stays hidden until it is actually playing; meanwhile
    // the thumbnail shows, as soon as it has loaded. (Check before
    // rewinding: rewinding briefly resets readyState.)
    const box = v.parentElement!;
    const img = box.querySelector('img');
    const on = () => hovered === v && box.classList.add('on');
    if (v.readyState >= 2) {
      box.classList.add('ready');
      on();
    } else {
      v.addEventListener('playing', () => (box.classList.add('ready'), on()), { once: true });
      if (img?.complete && img.naturalWidth) on();
      else img?.addEventListener('load', on, { once: true });
    }
    v.currentTime = 0;
    v.play().catch(() => {});
  }

  function hide(v: HTMLVideoElement) {
    if (hovered === v) hovered = null;
    v.parentElement!.classList.remove('on');
    setTimeout(() => hovered !== v && v.pause(), 150);
  }

  // Thumbnails first (small, so a hover shows at least the thumbnail right
  // away). The clips (about 60 MB together) wait until the showreel has
  // loaded, then come one at a time, so they never take bandwidth the
  // showreel needs (that made it pause now and then). Whenever the showreel
  // has to wait for data, the clips stop until it plays again.
  function reelLoaded() {
    return new Promise<void>((done) => {
      const check = () => {
        const b = reel.buffered;
        if (b.length && reel.duration && b.end(b.length - 1) >= reel.duration - 1) finish();
      };
      const finish = () => {
        reel.removeEventListener('progress', check);
        clearTimeout(timer);
        done();
      };
      // Some browsers stop loading a looping video early; don't wait forever.
      const timer = setTimeout(finish, 20000);
      reel.addEventListener('progress', check);
      check();
    });
  }

  function reelPlaying() {
    if (reel.paused || reel.readyState >= 3) return Promise.resolve();
    return new Promise((done) => reel.addEventListener('playing', done, { once: true }));
  }

  async function prefetchAll() {
    const conn = (navigator as any).connection;
    if (conn?.saveData || /2g/.test(conn?.effectiveType ?? '')) return;
    for (const a of links) if (a.dataset.thumb) new Image().src = a.dataset.thumb;
    await reelLoaded();
    for (const a of links) {
      await reelPlaying();
      const v = clipFor(a.dataset.preview!, a.dataset.thumb);
      if (v.readyState < 4)
        await new Promise((done) => {
          v.addEventListener('canplaythrough', done, { once: true });
          v.addEventListener('error', done, { once: true });
          setTimeout(done, 6000);
        });
    }
  }

  // Safety net: if a mouseleave gets missed (fast moves, coming back to the
  // page), no clip may stay over the showreel.
  function hideAll() {
    for (const v of clips.values()) hide(v);
  }

  if (canHover) {
    for (const a of links) {
      const enter = () => show(clipFor(a.dataset.preview!, a.dataset.thumb));
      const leave = () => hide(clipFor(a.dataset.preview!));
      a.addEventListener('mouseenter', enter);
      a.addEventListener('mouseleave', leave);
      a.addEventListener('focus', enter);
      a.addEventListener('blur', leave);
    }

    document.querySelector('.menu')?.addEventListener('mouseleave', hideAll);
    document.documentElement.addEventListener('mouseleave', hideAll);
    addEventListener('pageshow', hideAll);
    addEventListener('pointermove', (e) => {
      if (hovered && !(e.target as Element).closest?.('[data-preview]')) hideAll();
    }, { passive: true });

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      prefetchAll();
    };
    reel.addEventListener('playing', start, { once: true });
    // If autoplay is blocked or the reel is missing, start anyway after load.
    addEventListener('load', () => setTimeout(start, 1500), { once: true });
  }
</script>
