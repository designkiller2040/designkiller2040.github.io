---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ProjectList from '../components/ProjectList.astro';
import Footer from '../components/Footer.astro';
import home from '../data/home.json';
import { withVersion } from '../data/projects';
import { existsSync } from 'node:fs';

// Showreel, its still frame and label are edited in /admin/ (Homepage).
// A Cloudflare video there wins over the uploaded MP4: the build copies it
// to /video/stream/reel.mp4 with its first frame (scripts/stream-reel.sh).
const fromStream = existsSync('public/video/stream/reel.mp4');
const reel = withVersion(fromStream ? '/video/stream/reel.mp4' : home.reel);
const poster = withVersion(fromStream && existsSync('public/video/stream/reel.jpg') ? '/video/stream/reel.jpg' : home.poster);
---

<Base theme="dark">
  <link slot="head" rel="preload" href={poster} as="image" />
  <noscript slot="head"><style>.loader { display: none; }</style></noscript>
  <script slot="head" is:inline>
    if (!document.documentElement.classList.contains('visited')) {
      document.documentElement.classList.add('loading');
      // Safety net in case the page script never runs.
      setTimeout(function () { document.documentElement.classList.remove('loading'); }, 7000);
    }
  </script>
  <!-- Loader: white logo on black while the showreel and the project
       thumbnails load (script below), then the black fades away and the
       showreel slowly fades up behind the logo. -->
  <div class="loader" aria-hidden="true">
    <span class="loader-logo"></span>
  </div>
  <main class="hero grid">
    <div class="stage" aria-hidden="true" style={`background-image: url("${poster}")`}>
      <!-- The reel is used as exported, no re-encoding. It stays invisible
           (the still behind it shows) until it is actually playing, so
           Safari's own play button never flashes up while it loads. -->
      <video class="reel" poster={poster} autoplay muted loop playsinline preload="auto">
        <source src={reel} type="video/mp4" />
      </video>
      <div class="reel-cover" style={`background-image: url("${poster}")`}></div>
      <div class="previews"></div>
    </div>

    <Header current="works" />

    <p class="reel-label">{home.label}</p>

    <!-- The same element as the list on every project page. -->
    <ProjectList class="menu" previews />

    <!-- Phones only: the page scrolls, so legal x privacy ends it. -->
    <Footer />
  </main>
</Base>

<style>
  /*
   * The hero is the page grid with three rows: header, open space, and the
   * bottom line with "Showreel 2025". The menu fills the right-hand columns
   * from the bottom up, level with the showreel label.
   *
   * All homepage text (header, menu, showreel label) is SF Pro Display, 8.83
   * design px on 10.05 (see --rm in global.css), so it scales with the window
   * like Readymag. The header and the menu are the same as on every project
   * page, so they don't move when you switch pages.
   */
  .hero {
    /* 14px on 16px on alona's 14" MacBook, like the project pages. */
    --text: calc(8.83 * var(--rm));
    --line: calc(10.05 * var(--rm));
    --tracking: -0.06em;
    font-family: var(--font-sans);
    font-size: var(--text);
    line-height: var(--line);
    position: relative;
    height: 100vh;
    height: 100svh;
    grid-template-rows: auto minmax(0, 1fr) auto;
    row-gap: var(--top);
    padding-block: var(--top) var(--margin);
    /* clip, not hidden: hidden made the hero its own scroll box, which pushed
       the sticky menu down by an extra --top (2026-10-29: it now sits exactly
       where it is on Contact and every other page). */
    overflow: clip;
  }

  .stage {
    position: absolute;
    inset: 0;
    background: #000 center / cover no-repeat;
  }
  .stage .reel {
    opacity: 0;
    transition: opacity 200ms linear;
  }
  .stage .reel.playing {
    opacity: 1;
  }
  /* Safari can show its play button even on an invisible video, so the still
     also lies on top of the reel (and its canvas) until the reel plays. */
  .reel-cover {
    position: absolute;
    inset: 0;
    background: #000 center / cover no-repeat;
    pointer-events: none;
    transition: opacity 200ms linear;
  }
  .stage:has(.reel.playing) .reel-cover {
    opacity: 0;
  }
  .stage :global(video),
  .stage :global(.preview),
  .stage :global(.preview img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stage :global(.preview) {
    opacity: 0;
    transition: opacity 120ms linear;
  }
  .stage :global(.preview.on) {
    opacity: 1;
  }
  /* Until its clip plays, a preview shows only the thumbnail underneath. */
  .stage :global(.preview:not(.ready) :is(video, .video-canvas)) {
    visibility: hidden;
  }
  /* ...and the thumbnail lies on top of the clip until then, for the same
     Safari play-button reason as the reel. */
  .stage :global(.preview img) {
    z-index: 1;
  }
  .stage :global(.preview.ready img) {
    visibility: hidden;
  }

  /* Desktop is one screen with no footer; phones show it under the list. */
  .hero :global(.legal) {
    display: none;
  }

  /* Logo and menu take the same difference blend as the project list. */
  .hero :global(.header) {
    color: #fff;
    mix-blend-mode: difference;
  }

  .reel-label {
    grid-row: 3;
    grid-column: 1 / 9;
    align-self: end;
    position: relative;
    margin: 0;
    line-height: 1;
    color: #fff;
    mix-blend-mode: difference; /* same as the logo and menu */
  }

  /*
   * The project list (src/components/ProjectList.astro): the same element,
   * size and place as on every project page, anchored bottom right.
   */
  .hero :global(.menu) {
    grid-row: 2 / 4;
    grid-column: 13 / -1;
    align-self: end;
    justify-self: end;
    max-height: 100%;
    position: relative;
    mix-blend-mode: difference;
  }

  /*
   * Loader (first visit in a tab only, see Base.astro): the white logo on
   * black. Reveal: the black slowly fades away so the showreel comes up
   * behind the logo, then the logo fades out and the menu, list and label
   * fade in. If the script never runs, the CSS takes the loader away by
   * itself after 7 seconds.
   */
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100010; /* above the sticky menu */
    pointer-events: none;
    background: #000;
    animation: loader-bail 0s 7s forwards;
  }
  :global(html.visited) .loader {
    display: none;
  }
  .loader-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(112 * var(--rm) * 1.35);
    aspect-ratio: 192 / 65;
    translate: -50% -50%;
    background: #fff;
    -webkit-mask: url(/images/logo.svg) center / 100% 100% no-repeat;
    mask: url(/images/logo.svg) center / 100% 100% no-repeat;
  }
  @keyframes loader-bail {
    to { visibility: hidden; }
  }

  .loader.open {
    background: transparent;
    transition: background-color 1.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .loader.open .loader-logo {
    opacity: 0;
    transition: opacity 1s ease 0.9s;
  }

  /* While the loader is up the page's own text waits, then fades in. */
  :global(html.loading) .hero :global(:is(.logo-mark, .nav, .insta, .menu)),
  :global(html.loading) .reel-label {
    opacity: 0;
  }
  :global(html.revealing) .hero :global(:is(.logo-mark, .nav, .insta, .menu)),
  :global(html.revealing) .reel-label {
    transition: opacity 900ms ease 1.4s;
  }


  /*
   * Phone: the showreel stays fixed behind the page and the menu scrolls up
   * over it, starting just below the middle of the first screen. Taps open the
   * project straight away (there are no hover previews on touch screens).
   */
  @media (max-width: 767px) {
    .hero {
      /* Phones keep 10px text: the desktop size would be too small to read. */
      --text: 10px;
      --line: 12px;
      --tracking: -0.06em;
      height: auto;
      min-height: 100svh;
      grid-template-rows: auto auto;
      overflow: visible;
    }
    .stage {
      position: fixed;
    }
    /* The list now starts near the top, so the label would sit on it. */
    .reel-label {
      display: none;
    }
    .hero :global(.menu) {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-self: stretch;
      max-height: none;
      /* The list text starts 111px below the top menu's text (the row gap
         and the header's own spacing add the rest). */
      margin-top: calc(96px - var(--top));
    }
    /* legal x privacy under the list, then 50px to the bottom edge. */
    .hero {
      grid-template-rows: auto auto auto;
      padding-bottom: 50px;
    }
    .hero :global(.legal) {
      display: flex;
      grid-row: 3;
      justify-content: center;
      font-size: 16px;
      line-height: 18px;
      mix-blend-mode: difference;
      color: #fff;
    }
  }
</style>

<script>
  import { coverWithCanvas } from '../scripts/video-canvas';

  // Hover previews. Each menu link carries its clip's URL in data-preview.
  // Clips are created lazily: one after another once the showreel is playing,
  // or immediately when a link is hovered before its turn comes.
  const stage = document.querySelector<HTMLElement>('.previews')!;
  const reel = document.querySelector<HTMLVideoElement>('.reel')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-preview]')];
  const clips = new Map<string, HTMLVideoElement>();
  coverWithCanvas(reel);
  const showReel = () => reel.classList.add('playing');
  if (!reel.paused && reel.readyState > 2) showReel();
  else reel.addEventListener('playing', showReel, { once: true });
  let hovered: HTMLVideoElement | null = null;

  // Some browsers (Safari in Low Power Mode, some embedded viewers) block
  // autoplay. If so, start the showreel on the visitor's first interaction.
  reel.play().catch(() => {
    const kick = () => reel.play().catch(() => {});
    for (const ev of ['pointerdown', 'pointermove', 'keydown', 'touchstart', 'scroll'])
      addEventListener(ev, kick, { once: true, passive: true });
  });

  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  function clipFor(src: string, thumb?: string) {
    let v = clips.get(src);
    if (!v) {
      // Each clip sits in its own box, so the box (clip plus Safari's
      // canvas, see video-canvas.ts) fades in and out as one.
      const box = document.createElement('div');
      box.className = 'preview';
      v = document.createElement('video');
      v.muted = true;
      v.loop = true;
      v.playsInline = true;
      v.preload = 'auto';
      v.src = src;
      // The project's thumbnail sits under the clip, so a hover before the
      // clip has loaded shows the thumbnail instead of nothing.
      if (thumb) {
        const img = new Image();
        img.alt = '';
        img.decoding = 'async';
        img.src = thumb;
        box.append(img);
      }
      box.append(v);
      stage.append(box);
      coverWithCanvas(v);
      clips.set(src, v);
    }
    return v;
  }

  function show(v: HTMLVideoElement) {
    for (const other of clips.values()) if (other !== v) hide(other);
    hovered = v;
    // The clip itself stays hidden until it is actually playing; meanwhile
    // the thumbnail shows, as soon as it has loaded. (Check before
    // rewinding: rewinding briefly resets readyState.)
    const box = v.parentElement!;
    const img = box.querySelector('img');
    const on = () => hovered === v && box.classList.add('on');
    if (v.readyState >= 2) {
      box.classList.add('ready');
      on();
    } else {
      v.addEventListener('playing', () => (box.classList.add('ready'), on()), { once: true });
      if (img?.complete && img.naturalWidth) on();
      else img?.addEventListener('load', on, { once: true });
    }
    v.currentTime = 0;
    v.play().catch(() => {});
  }

  function hide(v: HTMLVideoElement) {
    if (hovered === v) hovered = null;
    v.parentElement!.classList.remove('on');
    setTimeout(() => hovered !== v && v.pause(), 150);
  }

  // Thumbnails first (small, so a hover shows at least the thumbnail right
  // away). The clips (about 60 MB together) wait until the showreel has
  // loaded, then come one at a time, so they never take bandwidth the
  // showreel needs (that made it pause now and then). Whenever the showreel
  // has to wait for data, the clips stop until it plays again.
  function reelLoaded() {
    return new Promise<void>((done) => {
      const check = () => {
        const b = reel.buffered;
        if (b.length && reel.duration && b.end(b.length - 1) >= reel.duration - 1) finish();
      };
      const finish = () => {
        reel.removeEventListener('progress', check);
        clearTimeout(timer);
        done();
      };
      // Some browsers stop loading a looping video early; don't wait forever.
      const timer = setTimeout(finish, 20000);
      reel.addEventListener('progress', check);
      check();
    });
  }

  function reelPlaying() {
    if (reel.paused || reel.readyState >= 3) return Promise.resolve();
    return new Promise((done) => reel.addEventListener('playing', done, { once: true }));
  }

  async function prefetchAll() {
    const conn = (navigator as any).connection;
    if (conn?.saveData || /2g/.test(conn?.effectiveType ?? '')) return;
    for (const a of links) if (a.dataset.thumb) new Image().src = a.dataset.thumb;
    await reelLoaded();
    for (const a of links) {
      await reelPlaying();
      const v = clipFor(a.dataset.preview!, a.dataset.thumb);
      if (v.readyState < 4)
        await new Promise((done) => {
          v.addEventListener('canplaythrough', done, { once: true });
          v.addEventListener('error', done, { once: true });
          setTimeout(done, 6000);
        });
    }
  }

  // Safety net: if a mouseleave gets missed (fast moves, coming back to the
  // page), no clip may stay over the showreel.
  function hideAll() {
    for (const v of clips.values()) hide(v);
  }

  // Loader. It waits for the showreel to be ready to play and for every
  // project thumbnail (so a hover shows something straight away). It stays
  // at least MIN so the logo doesn't just flash, and at most MAX so a slow
  // connection never sits on a black screen: whatever isn't loaded by then
  // keeps loading behind the page. The hover clips themselves (about 60 MB)
  // aren't waited for; they follow one by one as before.
  const MIN = 1200;
  const MAX = 3500;
  const html = document.documentElement;
  const loader = document.querySelector<HTMLElement>('.loader');
  if (loader && html.classList.contains('loading')) {
    const t0 = performance.now();
    const reelReady = new Promise<void>((done) => {
      if (reel.readyState >= 4) return done();
      reel.addEventListener('canplaythrough', () => done(), { once: true });
      reel.addEventListener('playing', () => done(), { once: true });
      // A video that fails reports it on its <source>, not on the video.
      reel.querySelector('source')?.addEventListener('error', () => done(), { once: true });
    });
    const thumbs = [...new Set(links.map((a) => a.dataset.thumb).filter(Boolean))].map(
      (src) =>
        new Promise<void>((done) => {
          const img = new Image();
          img.onload = img.onerror = () => done();
          img.src = src!;
        }),
    );
    const wait = (ms: number) => new Promise((done) => setTimeout(done, ms));
    Promise.race([Promise.all([reelReady, ...thumbs, wait(MIN)]), wait(MAX)]).then(() => {
      console.info(`Loader: ${Math.round(performance.now() - t0)} ms`);
      reveal(loader);
    });
  }

  function reveal(loader: HTMLElement) {
    html.classList.add('revealing');
    loader.classList.add('open');
    requestAnimationFrame(() => html.classList.remove('loading'));
    setTimeout(() => {
      loader.remove();
      html.classList.remove('revealing');
    }, 2500);
  }

  if (canHover) {
    for (const a of links) {
      const enter = () => show(clipFor(a.dataset.preview!, a.dataset.thumb));
      const leave = () => hide(clipFor(a.dataset.preview!));
      a.addEventListener('mouseenter', enter);
      a.addEventListener('mouseleave', leave);
      a.addEventListener('focus', enter);
      a.addEventListener('blur', leave);
    }

    document.querySelector('.menu')?.addEventListener('mouseleave', hideAll);
    document.documentElement.addEventListener('mouseleave', hideAll);
    addEventListener('pageshow', hideAll);
    addEventListener('pointermove', (e) => {
      if (hovered && !(e.target as Element).closest?.('[data-preview]')) hideAll();
    }, { passive: true });

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      prefetchAll();
    };
    reel.addEventListener('playing', start, { once: true });
    // If autoplay is blocked or the reel is missing, start anyway after load.
    addEventListener('load', () => setTimeout(start, 1500), { once: true });
  }
</script>
