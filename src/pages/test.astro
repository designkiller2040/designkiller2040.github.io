---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

const TEXT = 'film director from NY, based worldwide, filmed mood videos, video clips, personal videos, commercials';
const words = TEXT.split(' ');
---

<Base title="Test">
  <main class="test grid">
    <Header />
    <div class="stage">
      <p class="scatter" aria-label={TEXT}>
        {
          words.map((w, i) => (
            <>
              <span class="word" aria-hidden="true">
                {[...w].map((ch) => (
                  <span class="ch">{ch}</span>
                ))}
              </span>
              {i < words.length - 1 && ' '}
            </>
          ))
        }
      </p>
    </div>
  </main>
</Base>

<style>
  /*
   * Test page: the letters of one sentence start scattered and rotated across
   * the screen and fly in to form a justified paragraph. Move the mouse
   * through them to knock them away; click anywhere to scatter them again.
   */
  .test {
    min-height: 100vh;
    min-height: 100svh;
    grid-template-rows: auto 1fr;
    padding-block: var(--top) var(--margin);
    overflow: hidden;
  }
  .stage {
    grid-column: 1 / -1;
    display: grid;
    place-items: center;
  }
  .scatter {
    position: relative;
    width: min(100%, calc(330 * var(--rm)));
    margin: 0;
    font-size: calc(16 * var(--rm));
    line-height: 1.05;
    font-weight: 700;
    text-align: justify;
    text-align-last: justify;
    text-indent: 3.4em;
    user-select: none;
    cursor: default;
  }
  .scatter :global(*) {
    letter-spacing: -0.06em;
  }
  .word {
    display: inline-block;
    white-space: nowrap;
    text-indent: 0;
  }
  .ch {
    display: inline-block;
    will-change: transform;
  }
  @media (max-width: 767px) {
    .scatter {
      font-size: 22px;
      text-indent: 1.5em;
    }
  }
</style>

<script>
  // Simple spring physics per letter: each one is pulled back to its place in
  // the paragraph, starts far away at a random angle, and is pushed by the
  // mouse when it gets close.
  const box = document.querySelector<HTMLElement>('.scatter')!;
  const els = [...box.querySelectorAll<HTMLElement>('.ch')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type L = { el: HTMLElement; hx: number; hy: number; x: number; y: number; r: number; vx: number; vy: number; vr: number; wait: number };
  const letters: L[] = els.map((el) => ({ el, hx: 0, hy: 0, x: 0, y: 0, r: 0, vx: 0, vy: 0, vr: 0, wait: 0 }));

  const STIFF = 0.035; // pull back to place
  const DAMP = 0.86; // how quickly motion settles (lower = calmer)
  const RADIUS = 70; // mouse reach, px
  const PUSH = 3; // mouse strength

  // Home position of each letter's centre, relative to the paragraph.
  function measure() {
    // (.scatter is position: relative, so offsets are measured from it.)
    for (const l of letters) {
      l.hx = l.el.offsetLeft + l.el.offsetWidth / 2;
      l.hy = l.el.offsetTop + l.el.offsetHeight / 2;
    }
  }

  function scatter() {
    const w = innerWidth;
    const h = innerHeight;
    const b = box.getBoundingClientRect();
    letters.forEach((l) => {
      // Random spot on screen, expressed as an offset from the letter's home.
      l.x = Math.random() * w - (b.left + l.hx);
      l.y = Math.random() * h - (b.top + l.hy);
      l.r = (Math.random() - 0.5) * 360;
      l.vx = l.vy = l.vr = 0;
      l.wait = Math.random() * 60; // frames before it starts flying home
    });
    wake();
  }

  let mx = -1e4;
  let my = -1e4;
  addEventListener('pointermove', (e) => {
    const b = box.getBoundingClientRect();
    mx = e.clientX - b.left;
    my = e.clientY - b.top;
    wake();
  });
  addEventListener('pointerleave', () => {
    mx = my = -1e4;
  });

  let running = false;
  function wake() {
    if (!running) {
      running = true;
      requestAnimationFrame(step);
    }
  }

  function step() {
    let moving = false;
    for (const l of letters) {
      if (l.wait > 0) {
        l.wait--;
        moving = true;
        draw(l);
        continue;
      }
      // Spring back home.
      let ax = -l.x * STIFF;
      let ay = -l.y * STIFF;
      let ar = -l.r * STIFF;
      // Push away from the mouse.
      const dx = l.hx + l.x - mx;
      const dy = l.hy + l.y - my;
      const d = Math.hypot(dx, dy);
      if (d < RADIUS && d > 0.01) {
        const f = (1 - d / RADIUS) * PUSH;
        ax += (dx / d) * f;
        ay += (dy / d) * f;
        ar += (dx > 0 ? 1 : -1) * f * 1.5;
      }
      l.vx = (l.vx + ax) * DAMP;
      l.vy = (l.vy + ay) * DAMP;
      l.vr = (l.vr + ar) * DAMP;
      l.x += l.vx;
      l.y += l.vy;
      l.r += l.vr;
      if (Math.abs(l.x) + Math.abs(l.y) + Math.abs(l.r) + Math.abs(l.vx) + Math.abs(l.vy) > 0.05) moving = true;
      else l.x = l.y = l.r = l.vx = l.vy = l.vr = 0;
      draw(l);
    }
    if (moving) requestAnimationFrame(step);
    else running = false;
  }

  function draw(l: L) {
    l.el.style.transform = l.x || l.y || l.r ? `translate(${l.x}px, ${l.y}px) rotate(${l.r}deg)` : '';
  }

  measure();
  addEventListener('resize', measure);
  if (!still) {
    scatter();
    addEventListener('click', (e) => {
      if (!(e.target as Element).closest('a')) scatter();
    });
  }
</script>
