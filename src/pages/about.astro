---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const TITLE = 'film director from NY, based worldwide, filmed mood videos, video clips, personal videos, commercials';
const words = TITLE.split(' ');
---

<Base title="About">
  <main class="about grid">
    <Header current="about" />

    <!--
      The title animation plays once per visit. Until it has played, the photo
      and bio stay hidden (set here, before they appear, so they never flash).
    -->
    <script is:inline>
      try {
        var reload = (performance.getEntriesByType('navigation')[0] || {}).type === 'reload';
        if ((reload || !sessionStorage.getItem('about-intro')) && !matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.classList.add('about-intro');
      } catch (e) {}
    </script>

    <!-- Animated title from the test page: letters fly in and dodge the mouse. -->
    <div class="stage">
      <h1 class="scatter box" aria-label={TITLE}>
        {
          words.map((w, i) => (
            <>
              <span class="word" aria-hidden="true">
                {[...w].map((ch) => (
                  <span class="ch">{ch}</span>
                ))}
              </span>
              {i < words.length - 1 && ' '}
            </>
          ))
        }
      </h1>
    </div>

    <!-- TODO: swap in the original photo. This one is cropped from a screenshot. -->
    <img class="photo" src="/images/jonah-about.jpg" width="1330" height="1426" alt="Jonah George" />

    <div class="bio box">
      <p>
        Born and raised in Bethlehem Pennsylvania, Jonah George is a self taught commercial, narrative, and
        music video director whos work is inspired by nostalgic moments from real life. He started creating
        video at the age of 5 when receiving a VHS camera as a gift from his parents. From there he began his
        work in the music industry capturing music tours and soon after that began directing for artists.
        Currently he's focused on commercial campaigns and documentary work.
      </p>
      <p>
        Jonah George is focused on the efficient execution of creative ideas for brands, artists and narrative
        projects. He has eight years of professional experience in directing, creative producing and
        cinematography. Favoring shooting on location, Jonah's started in the United states but is currently
        working on projects worldwide with production experience in 26 countries worldwide.
      </p>
      <p>
        Clients: Nike. Omega. Sony Music. Givenchy. UMG. Kasina. Coach. Play Station. Backbone. Lauv. Paul
        Mitchell. Starface. Jeremy Zucker. ayokay. and more
      </p>
    </div>

    <Footer />
  </main>
</Base>

<style>
  /*
   * Everything is centred in one column. The animated title sits mid-screen,
   * then the photo, then the bio. Title and bio share the same text
   * box (.box: same width, same position), both justified.
   */
  .about {
    grid-template-rows: auto;
    overflow-x: clip;
    padding-block: var(--top) var(--margin);
  }
  .about > * {
    grid-column: 1 / -1;
  }
  .box {
    justify-self: center;
    width: min(100%, calc(330 * var(--rm)));
    text-align: justify;
  }

  /* Title sits around the middle of the first screen; the photo peeks in below. */
  .stage {
    display: grid;
    padding-top: calc(50svh - 66 * var(--rm));
  }
  .scatter {
    position: relative;
    margin: 0;
    font-size: calc(16 * var(--rm));
    line-height: 1.05;
    font-weight: 700;
    text-indent: 3.4em;
    user-select: none;
    cursor: default;
  }
  .scatter :global(*) {
    letter-spacing: -0.06em;
  }
  .word {
    display: inline-block;
    white-space: nowrap;
    text-indent: 0;
  }
  .ch {
    display: inline-block;
    will-change: transform;
  }

  /* Photo and bio fade in once the title animation has finished. */
  .photo,
  .bio {
    transition: opacity 1.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global(.about-intro) .photo,
  :global(.about-intro) .bio {
    opacity: 0;
  }

  .photo {
    justify-self: center;
    width: calc(189 * var(--rm)); /* 300px on alona's MacBook */
    height: auto;
    margin-top: calc(58 * var(--rm));
  }

  .bio {
    width: min(100%, calc(189 * var(--rm))); /* same width as the photo */
    margin-top: calc(64 * var(--rm));
    font-size: calc(12.6 * var(--rm)); /* 20px on alona's MacBook */
    line-height: calc(14.4 * var(--rm));
    font-weight: 700;
  }
  .bio p {
    margin: 0 0 calc(14.4 * var(--rm));
  }

  .about > :global(.legal) {
    margin-top: calc(80 * var(--rm));
  }

  @media (max-width: 767px) {
    .stage {
      padding-top: calc(50svh - 160px);
    }
    .box {
      width: 100%;
    }
    .scatter {
      font-size: 22px;
      text-indent: 1.5em;
    }
    .photo,
    .bio {
      width: 75%;
    }
    .photo {
      margin-top: 40px;
    }
    .bio {
      margin-top: 40px;
      font-size: 18px;
      line-height: 21px;
    }
    .bio p {
      margin-bottom: 21px;
    }
    .about > :global(.legal) {
      margin-top: 40px;
    }
  }
</style>

<script>
  // Same physics as the test page: each letter starts scattered across the
  // screen and springs back into the title; the mouse pushes letters away.
  // Click the title area to scatter them again. The fly-in plays once per
  // visit: coming back to the page shows the finished title straight away.
  const box = document.querySelector<HTMLElement>('.scatter')!;
  const stage = document.querySelector<HTMLElement>('.stage')!;
  const els = [...box.querySelectorAll<HTMLElement>('.ch')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type L = { el: HTMLElement; hx: number; hy: number; x: number; y: number; r: number; vx: number; vy: number; vr: number; wait: number };
  const letters: L[] = els.map((el) => ({ el, hx: 0, hy: 0, x: 0, y: 0, r: 0, vx: 0, vy: 0, vr: 0, wait: 0 }));

  const STIFF = 0.035; // pull back to place
  const DAMP = 0.73; // how quickly motion settles; this low, letters glide in without bouncing past their place
  const RADIUS = 70; // mouse reach, px
  const PUSH = 3; // mouse strength

  // Home position of each letter's centre, relative to the title.
  function measure() {
    for (const l of letters) {
      l.hx = l.el.offsetLeft + l.el.offsetWidth / 2;
      l.hy = l.el.offsetTop + l.el.offsetHeight / 2;
    }
  }

  // Letters start scattered all over the screen, turned every which way,
  // and fly home into the title.
  function scatter() {
    const b = box.getBoundingClientRect();
    const w = innerWidth;
    const h = innerHeight;
    letters.forEach((l) => {
      l.x = Math.random() * w - (b.left + l.hx);
      l.y = Math.random() * h - (b.top + l.hy);
      l.r = (Math.random() - 0.5) * 360;
      l.vx = l.vy = l.vr = 0;
      l.wait = Math.random() * 60; // frames before it starts flying home
    });
    wake();
  }

  let mx = -1e4;
  let my = -1e4;
  addEventListener('pointermove', (e) => {
    const b = box.getBoundingClientRect();
    mx = e.clientX - b.left;
    my = e.clientY - b.top;
    wake();
  });
  document.addEventListener('pointerleave', () => {
    mx = my = -1e4;
  });

  let running = false;
  function wake() {
    if (!running) {
      running = true;
      requestAnimationFrame(step);
    }
  }

  function step() {
    let moving = false;
    for (const l of letters) {
      if (l.wait > 0) {
        l.wait--;
        moving = true;
        draw(l);
        continue;
      }
      let ax = -l.x * STIFF;
      let ay = -l.y * STIFF;
      let ar = -l.r * STIFF;
      const dx = l.hx + l.x - mx;
      const dy = l.hy + l.y - my;
      const d = Math.hypot(dx, dy);
      if (d < RADIUS && d > 0.01) {
        const f = (1 - d / RADIUS) * PUSH;
        ax += (dx / d) * f;
        ay += (dy / d) * f;
        ar += (dx > 0 ? 1 : -1) * f * 1.5;
      }
      l.vx = (l.vx + ax) * DAMP;
      l.vy = (l.vy + ay) * DAMP;
      l.vr = (l.vr + ar) * DAMP;
      l.x += l.vx;
      l.y += l.vy;
      l.r += l.vr;
      if (Math.abs(l.x) + Math.abs(l.y) + Math.abs(l.r) + Math.abs(l.vx) + Math.abs(l.vy) > 0.05) moving = true;
      else l.x = l.y = l.r = l.vx = l.vy = l.vr = 0;
      draw(l);
    }
    if (moving) requestAnimationFrame(step);
    else {
      running = false;
      setTimeout(reveal, 250); // a short beat after the last letter stops
    }
  }

  function draw(l: L) {
    l.el.style.transform = l.x || l.y || l.r ? `translate(${l.x}px, ${l.y}px) rotate(${l.r}deg)` : '';
  }

  // First fly-in finished: remember it and fade in the photo and bio.
  const root = document.documentElement;
  function reveal() {
    if (!root.classList.contains('about-intro')) return;
    root.classList.remove('about-intro');
    try {
      sessionStorage.setItem('about-intro', '1');
    } catch (e) {}
  }

  measure();
  addEventListener('resize', measure);
  if (!still) {
    if (root.classList.contains('about-intro')) scatter();
    stage.addEventListener('click', scatter);
  }
</script>
