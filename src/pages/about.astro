---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="About">
  <main class="about grid">
    <Header current="about" />

    <!-- TODO: swap in the original photo. This one is cropped from a screenshot. -->
    <img class="photo" src="/images/jonah-about.jpg" width="1330" height="1426" alt="Jonah George" />

    <div class="text">
      <p>
        Born and raised in Bethlehem Pennsylvania, Jonah George is a self taught commercial, narrative, and
        music video director whos work is inspired by nostalgic <b>moments from real life.</b> He started
        creating video at the age of 5 when receiving a VHS camera as a gift from his parents. From there he
        began his work in the music industry capturing music tours and soon after that began directing for
        artists. Currently he's focused on commercial campaigns and documentary work.
      </p>
      <p>
        Jonah George is focused on the efficient execution of creative ideas for brands, artists and narrative
        projects. He has eight years of professional experience in directing, creative producing and
        cinematography. Favoring shooting on location, Jonah's started in the United states but is currently
        working on projects worldwide with production experience in 26 countries <b>worldwide.</b>
      </p>
      <p class="clients">
        <b>Clients:</b> Nike. Omega. Sony Music. Givenchy. UMG. Kasina. Coach. Play Station. Backbone. Lauv. Paul
        Mitchell. Starface. Jeremy Zucker. ayokay. and more
      </p>
    </div>

    <Footer />
  </main>
</Base>

<style>
  /*
   * Same structure as the Readymag About page: photo on the left (columns
   * 1-10), the bio centred on the right (columns 13-22) and level with the
   * photo, legal links at the bottom of the window. Sizes are design px.
   */
  .about {
    min-height: 100vh;
    min-height: 100svh;
    grid-template-rows: auto 1fr auto;
    padding-block: var(--top) var(--margin);
  }
  .photo {
    grid-row: 2;
    grid-column: 1 / 11;
    align-self: start;
    width: 100%;
    height: auto;
    margin-top: calc(14 * var(--rm));
  }
  .text {
    grid-row: 2;
    grid-column: 13 / 23;
    align-self: center;
    text-align: center;
    font-size: calc(8.8 * var(--rm));
    line-height: calc(12.2 * var(--rm));
  }
  .text p {
    margin: 0 0 calc(14.5 * var(--rm));
  }
  .text b {
    font-weight: 700;
  }
  .text .clients {
    margin-top: calc(48 * var(--rm));
    font-size: calc(8.8 * var(--rm));
    line-height: calc(11.4 * var(--rm));
  }
  .about > :global(.legal) {
    grid-row: 3;
  }

  /* Phone: photo, then the bio, then the legal links, one under another. */
  @media (max-width: 767px) {
    .about {
      grid-template-rows: auto;
      row-gap: 28px;
    }
    .photo,
    .text,
    .about > :global(.legal) {
      grid-row: auto;
      grid-column: 1 / -1;
      margin-top: 0;
    }
    .photo {
      margin-top: 12px;
    }
    .text {
      font-size: 14px;
      line-height: 19px;
    }
    .text .clients {
      margin-top: 28px;
      font-size: 12px;
      line-height: 16px;
    }
  }
</style>
