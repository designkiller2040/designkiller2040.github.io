---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const TITLE = 'film director from NY, based worldwide, filmed mood videos, video clips, personal videos, commercials';
const words = TITLE.split(' ');
---

<Base title="About">
  <main class="about grid">
    <Header current="about" />

    <div class="stage">
      <h1 class="title box" aria-label={TITLE}>
        {
          words.map((w, i) => (
            <>
              <span class="word" aria-hidden="true">
                {[...w].map((ch) => (
                  <span class="ch">{ch}</span>
                ))}
              </span>
              {i < words.length - 1 && ' '}
            </>
          ))
        }
      </h1>
    </div>

    <!-- TODO: swap in the original photo. This one is cropped from a screenshot. -->
    <img class="photo" src="/images/jonah-about.jpg" width="1330" height="1426" alt="Jonah George" />

    <div class="bio box">
      <p>
        Born and raised in Bethlehem Pennsylvania, Jonah George is a self taught commercial, narrative, and
        music video director whos work is inspired by nostalgic moments from real life. He started creating
        video at the age of 5 when receiving a VHS camera as a gift from his parents. From there he began his
        work in the music industry capturing music tours and soon after that began directing for artists.
        Currently he's focused on commercial campaigns and documentary work.
      </p>
      <p>
        Jonah George is focused on the efficient execution of creative ideas for brands, artists and narrative
        projects. He has eight years of professional experience in directing, creative producing and
        cinematography. Favoring shooting on location, Jonah's started in the United states but is currently
        working on projects worldwide with production experience in 26 countries worldwide.
      </p>
      <p>
        Clients: Nike. Omega. Sony Music. Givenchy. UMG. Kasina. Coach. Play Station. Backbone. Lauv. Paul
        Mitchell. Starface. Jeremy Zucker. ayokay. and more
      </p>
    </div>

    <Footer />
  </main>
</Base>

<style>
  /*
   * Everything is centred in one column. The title sits mid-screen,
   * then the photo, then the bio. Title and bio share the same text
   * box (.box: same width, same position), both justified.
   */
  .about {
    grid-template-rows: auto;
    overflow-x: clip;
    padding-block: var(--top) var(--margin);
  }
  .about > * {
    grid-column: 1 / -1;
  }
  .box {
    justify-self: center;
    width: min(100%, calc(330 * var(--rm)));
    text-align: justify;
  }

  /* Title sits around the middle of the first screen; the photo peeks in below. */
  .stage {
    display: grid;
    padding-top: calc(50svh - 66 * var(--rm));
  }
  .title {
    position: relative;
    margin: 0;
    font-size: calc(15.1 * var(--rm)); /* 24px on alona's MacBook */
    line-height: 1.05;
    font-weight: 700;
    text-indent: 3.4em;
  }
  .title,
  .title :global(*) {
    letter-spacing: -0.06em;
  }
  /* Each letter is its own box so it can fly away when the mouse hits it. */
  .title {
    user-select: none;
    cursor: default;
  }
  .word {
    display: inline-block;
    white-space: nowrap;
    text-indent: 0;
  }
  .ch {
    display: inline-block;
    will-change: transform;
  }

  /*
   * Photo and bio: 333px wide on alona's MacBook, right edge lined up with
   * the title's right edge (title box 330 wide, so shift right by the
   * difference of the half widths).
   */
  .photo,
  .bio {
    justify-self: center;
    position: relative;
    left: calc((330 - 209.8) / 2 * var(--rm));
  }

  .photo {
    width: calc(209.8 * var(--rm)); /* 333px on alona's MacBook */
    height: auto;
    margin-top: calc(58 * var(--rm));
  }

  .bio {
    width: calc(209.8 * var(--rm)); /* same width as the photo */
    margin-top: calc(64 * var(--rm));
    font-size: calc(13.9 * var(--rm)); /* 22px on alona's MacBook */
    line-height: calc(15.9 * var(--rm));
    font-weight: 700;
  }
  .bio p {
    margin: 0 0 calc(15.9 * var(--rm));
  }

  .about > :global(.legal) {
    margin-top: calc(80 * var(--rm));
  }

  @media (max-width: 767px) {
    .stage {
      padding-top: calc(50svh - 160px);
    }
    .box {
      width: 100%;
    }
    .title {
      font-size: 22px;
      text-indent: 1.5em;
    }
    .photo,
    .bio {
      width: 75%;
      justify-self: end; /* right edge lines up with the title */
      left: 0;
    }
    .photo {
      margin-top: 40px;
    }
    .bio {
      margin-top: 40px;
      font-size: 18px;
      line-height: 21px;
    }
    .bio p {
      margin-bottom: 21px;
    }
    .about > :global(.legal) {
      margin-top: 40px;
    }
  }
</style>

<script>
  // Title letters sit in place; when the mouse runs into them they get
  // knocked away (harder the faster the mouse moves), spin, and then float
  // back to their spot. Same spring idea as the old test page, in reverse.
  const box = document.querySelector<HTMLElement>('.about .title');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (box && !still) {
    type L = { el: HTMLElement; hx: number; hy: number; x: number; y: number; r: number; vx: number; vy: number; vr: number };
    const letters: L[] = [...box.querySelectorAll<HTMLElement>('.ch')].map((el) => ({
      el, hx: 0, hy: 0, x: 0, y: 0, r: 0, vx: 0, vy: 0, vr: 0,
    }));

    const STIFF = 0.012; // pull back to place (lower = they stay away longer)
    const DAMP = 0.93; // how quickly motion settles (lower = calmer)
    const RADIUS = 46; // mouse reach, px
    const PUSH = 7; // knock from the mouse itself
    const FLING = 0.9; // extra knock from mouse speed

    // Home position of each letter's centre, relative to the title.
    function measure() {
      for (const l of letters) {
        l.hx = l.el.offsetLeft + l.el.offsetWidth / 2;
        l.hy = l.el.offsetTop + l.el.offsetHeight / 2;
      }
    }

    // Mouse position on screen, and how far it moved since the last frame.
    let cx = -1e4;
    let cy = -1e4;
    let pdx = 0;
    let pdy = 0;
    addEventListener('pointermove', (e) => {
      if (cx > -1e4) {
        pdx += e.clientX - cx;
        pdy += e.clientY - cy;
      }
      cx = e.clientX;
      cy = e.clientY;
      wake();
    });
    document.addEventListener('pointerleave', () => {
      cx = cy = -1e4;
    });

    let running = false;
    function wake() {
      if (!running) {
        running = true;
        requestAnimationFrame(step);
      }
    }

    function step() {
      const b = box!.getBoundingClientRect();
      const mx = cx - b.left;
      const my = cy - b.top;
      const speed = Math.min(Math.hypot(pdx, pdy), 80);
      let moving = false;
      for (const l of letters) {
        // Spring back home.
        let ax = -l.x * STIFF;
        let ay = -l.y * STIFF;
        let ar = -l.r * STIFF;
        // Knock away from the mouse, only while the mouse is moving.
        const dx = l.hx + l.x - mx;
        const dy = l.hy + l.y - my;
        const d = Math.hypot(dx, dy);
        if (speed > 0.5 && d < RADIUS && d > 0.01) {
          const f = (1 - d / RADIUS) * (PUSH + speed * FLING);
          ax += (dx / d) * f + pdx * 0.15;
          ay += (dy / d) * f + pdy * 0.15;
          ar += (dx > 0 ? 1 : -1) * f * 1.2;
        }
        l.vx = (l.vx + ax) * DAMP;
        l.vy = (l.vy + ay) * DAMP;
        l.vr = (l.vr + ar) * DAMP;
        l.x += l.vx;
        l.y += l.vy;
        l.r += l.vr;
        if (Math.abs(l.x) + Math.abs(l.y) + Math.abs(l.r) + Math.abs(l.vx) + Math.abs(l.vy) > 0.05) moving = true;
        else l.x = l.y = l.r = l.vx = l.vy = l.vr = 0;
        l.el.style.transform = l.x || l.y || l.r ? `translate(${l.x}px, ${l.y}px) rotate(${l.r}deg)` : '';
      }
      pdx = pdy = 0;
      if (moving) requestAnimationFrame(step);
      else running = false;
    }

    measure();
    addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
  }
</script>

