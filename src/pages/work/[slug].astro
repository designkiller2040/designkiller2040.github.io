---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { projects, CREDIT_ORDER, posterSrc, stillSrcs, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const credits = CREDIT_ORDER.filter((l) => project.credits[l]).map((l) => ({
  label: l.toLowerCase(),
  value: project.credits[l]!,
}));
const embed = `https://player.vimeo.com/video/${project.vimeo}?dnt=1&title=0&byline=0&portrait=0&autoplay=1`;
---

<Base title={project.title}>
  <main class="page grid">
    <Header current="works" />

    <div class="titlebar">
      <a class="back" href="/" aria-label="Back to all works">&lt;</a>
      <h1>{project.title}</h1>
    </div>

    <div class="media">
      <div class="player" data-embed={embed} data-title={project.title}>
        <button class="play" type="button" aria-label={`Play ${project.title}`}>
          <img src={posterSrc(project)} alt="" />
          <span>Play</span>
        </button>
      </div>

      <div class="stills">
        {stillSrcs(project).map((src) => <img src={src} alt="" loading="lazy" />)}
      </div>
    </div>

    <aside class="info">
      <div class="about">
        <p class="label">about film:</p>
        {project.about && <p class="text">{project.about}</p>}
        {project.todo && <p class="todo">TODO: {project.todo}</p>}
      </div>
      <dl class="credits">
        {
          credits.map((r) => (
            <div class="row">
              <dt>{r.label}:</dt>
              <dd>{r.value}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </main>
</Base>

<script>
  // "Play" swaps the thumbnail for the Vimeo player and starts it.
  const player = document.querySelector<HTMLElement>('.player');
  player?.querySelector('.play')?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = player.dataset.embed ?? '';
    iframe.title = player.dataset.title ?? '';
    iframe.allow = 'autoplay; fullscreen; picture-in-picture';
    iframe.allowFullscreen = true;
    player.replaceChildren(iframe);
  });
</script>

<style>
  /*
   * Left: the film and its stills (columns 1-17). Right: the film's info
   * (columns 19-24), which stays put while the left side scrolls.
   */
  .page {
    padding-block: var(--top) var(--margin);
    align-items: start;
    font-size: var(--text);
  }
  /*
   * Project pages: title and info text 8.8 design px, about 14px on screen
   * on a 14" MacBook. Phones keep the sizes from global.css.
   */
  @media (min-width: 768px) {
    .page {
      --title: calc(8.8 * var(--rm));
      --text: calc(8.8 * var(--rm));
      --line: calc(10.6 * var(--rm));
    }
  }

  .titlebar {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    gap: calc(21 * var(--rm));
    margin: calc(var(--row) * 2.5) 0 calc(var(--row) * 2);
    font-size: var(--title);
    line-height: 1.2;
  }
  .titlebar h1 {
    margin: 0;
    font-size: inherit;
    font-weight: 500;
  }
  .back {
    font-weight: 500;
  }

  .media {
    grid-column: 1 / 18;
    display: grid;
    gap: calc(12 * var(--rm));
  }

  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .player iframe,
  .play,
  .play img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .play {
    padding: 0;
    background: #000;
    cursor: pointer;
    font: inherit;
  }
  .play img {
    object-fit: cover;
    display: block;
  }
  .play span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #cfe3ff;
    font-size: var(--title);
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .stills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(12 * var(--rm));
  }
  .stills img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    background: #000;
  }

  .info {
    grid-column: 19 / -1;
    grid-row: 3;
    /* Sits at the bottom of the window and stays there while the left side scrolls. */
    align-self: end;
    position: sticky;
    bottom: var(--margin);
    display: flex;
    flex-direction: column;
    gap: calc(var(--row) * 3);
    font-weight: 500;
    line-height: var(--line);
  }
  .info p {
    margin: 0;
  }
  .about .text {
    margin-top: var(--row);
    text-align: justify;
    hyphens: manual;
  }
  .credits {
    margin: 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 1em;
    margin-bottom: calc(var(--row) * 0.45);
  }
  dt,
  dd {
    margin: 0;
  }
  dd {
    text-align: right;
    max-width: 62%;
  }

  /* Phone: the film first, then the info, then the stills. */
  @media (max-width: 767px) {
    .media,
    .info {
      grid-column: 1 / -1;
    }
    .media {
      display: contents;
    }
    .player {
      grid-column: 1 / -1;
      margin-inline: calc(var(--margin) * -1);
      margin-bottom: 12px;
    }
    .info {
      position: static;
      grid-row: auto;
      margin-bottom: calc(var(--row) * 2);
    }
    .about .text {
      margin-top: var(--row);
    }
    .stills {
      grid-column: 1 / -1;
      order: 3;
      gap: 8px;
    }
    .titlebar {
      margin-top: calc(var(--row) * 1.5);
      gap: 14px;
    }
  }
</style>
