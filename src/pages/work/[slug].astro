---
/*
 * One page per project in src/data/projects.json, at /work/<slug>/.
 * The layout itself is in src/components/ProjectPage.astro.
 * Nike SNKRS - Newsstand is trying out a test layout (ProjectPageSplit.astro).
 */
import ProjectPage from '../../components/ProjectPage.astro';
import ProjectPageSplit from '../../components/ProjectPageSplit.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const Layout = project.slug === 'nike-snkrs-newsstand' ? ProjectPageSplit : ProjectPage;
---

<Layout project={project} />
