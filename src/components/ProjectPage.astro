---
/*
 * Project page layout, used by every project (src/pages/work/[slug].astro).
 *
 * The film's thumbnail fills the window. The about text and credits sit on
 * the left, and the list of all projects on the right, as on the homepage.
 * As you scroll, the list fades away, the thumbnail blurs and the stills
 * slide in one by one in a row.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import ProjectList from './ProjectList.astro';
import { CREDIT_ORDER, posterSrc, stillSrcs, type Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const credits = CREDIT_ORDER.filter((l) => project.credits[l]).map((l) => ({
  label: l.toLowerCase(),
  value: project.credits[l]!,
}));
const embed = `https://player.vimeo.com/video/${project.vimeo}?dnt=1&title=0&byline=0&portrait=0&autoplay=1`;
const poster = posterSrc(project);
---

<Base title={project.title} theme="dark">
  <link slot="head" rel="preload" href={poster} as="image" />

  <!-- The thumbnail. As you scroll it slides left, blurs and shrinks back. -->
  <div class="backdrop" aria-hidden="true">
    <div class="thumb"><img src={poster} alt="" /></div>
  </div>

  <div class="top grid">
    <Header current="works" />
  </div>

  <main class="scroll">
    <!-- Desktop: the page scrolls sideways. The stage stays in the window
         while the track slides left as you scroll. -->
    <div class="stage">
      <div class="track">
        <div class="hero">
          <button class="play" type="button" data-embed={embed} data-title={project.title}>
            <span class="play-label">Play full</span>
          </button>
        </div>

        <div class="shots grid">
          {stillSrcs(project).map((src) => <img class="shot" src={src} alt="" />)}
        </div>
      </div>
    </div>

    <aside class="info grid">
      <div class="col">
        <h1 class="sr-only">{project.title}</h1>
        <div class="about">
          <p class="label">about film:</p>
          {project.about && <p class="text">{project.about}</p>}
          {project.todo && <p class="todo">TODO: {project.todo}</p>}
        </div>
        <dl class="credits">
          {
            credits.map((r) => (
              <div class="row">
                <dt>{r.label}:</dt>
                <dd>{r.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- All projects: the same element as the homepage menu. -->
      <ProjectList class="list" current={project.slug} />
    </aside>
  </main>

  <!-- With a mouse, "Play full" follows the pointer over the thumbnail. -->
  <div class="cursor" aria-hidden="true"><span class="play-label">Play full</span></div>

  <div class="player" hidden>
    <button class="close" type="button" aria-label="Close film">close</button>
  </div>
</Base>

<script>
  const root = document.documentElement;

  // Desktop: the page itself doesn't scroll. The mouse wheel, trackpad,
  // arrow keys and touch move the track sideways instead, eased so it glides.
  // (Driving it from the page's own scroll made browsers bounce at the end
  // and reopen the page halfway through.)
  const desktop = window.matchMedia('(min-width: 768px)');
  const track = document.querySelector<HTMLElement>('.track');
  let distance = 0; // how far the track can slide, in px
  let target = 0; // where it's heading
  let current = 0; // where it is now
  let frame = 0;

  const clamp = (v: number) => Math.min(distance, Math.max(0, v));

  // The info column on the left. The stills line up with it (same top, same
  // height), and it fades out as the first still slides up to it.
  const col = document.querySelector<HTMLElement>('.info .col');
  const firstShot = document.querySelector<HTMLElement>('.shot');
  let shotStart = 0; // the first still's left edge before sliding, in px
  let colEnd = 0; // the info column's right edge, in px
  const fadeInfo = () => {
    if (!col) return;
    if (!distance || !firstShot) {
      col.style.opacity = '';
      col.style.visibility = '';
      return;
    }
    // Fully visible until the still is 60 design px away, gone when it touches.
    // (One design px, as --rm in global.css works it out.)
    const rm = Math.min(2, Math.max(1, Math.min(window.innerWidth / 880, window.innerHeight / 552)));
    const fade = 60 * rm;
    const o = Math.min(1, Math.max(0, (shotStart - current - colEnd) / fade));
    col.style.opacity = o.toFixed(3);
    // Once invisible, it stops catching clicks and text selection.
    col.style.visibility = o === 0 ? 'hidden' : '';
  };

  const render = () => {
    if (!track) return;
    track.style.transform = `translate3d(${-current}px, 0, 0)`;
    // Progress: 0 at the start, 1 at the end of the slide.
    const p = distance ? current / distance : 0;
    root.style.setProperty('--p', p.toFixed(4));
    // Once the project list has faded, it stops catching clicks.
    root.classList.toggle('list-gone', p > 0.2);
    fadeInfo();
  };

  const tick = () => {
    current += (target - current) * 0.14;
    if (Math.abs(target - current) < 0.5) current = target;
    render();
    frame = current === target ? 0 : requestAnimationFrame(tick);
  };
  const moveTo = (v: number) => {
    target = clamp(v);
    if (!frame) frame = requestAnimationFrame(tick);
  };

  const measure = () => {
    if (!track) return;
    if (desktop.matches) {
      root.classList.add('slide');
      if (col) {
        const r = col.getBoundingClientRect();
        root.style.setProperty('--shots-top', `${r.top}px`);
        root.style.setProperty('--shots-h', `${r.height}px`);
      }
      distance = Math.max(0, track.scrollWidth - window.innerWidth);
      if (col) colEnd = col.getBoundingClientRect().right;
      if (firstShot) shotStart = firstShot.offsetLeft;
      // Keep the same progress through the slide when the window resizes.
      const ratio = target && distance ? target / distance : 0;
      target = current = clamp(ratio * distance);
      render();
    } else {
      root.classList.remove('slide');
      distance = target = current = 0;
      track.style.transform = '';
      fadeInfo();
      onScroll();
    }
  };

  window.addEventListener(
    'wheel',
    (e) => {
      if (!desktop.matches || document.body.classList.contains('watching')) return;
      e.preventDefault();
      const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerHeight : 1;
      const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      moveTo(target + d * unit);
    },
    { passive: false },
  );

  document.addEventListener('keydown', (e) => {
    if (!desktop.matches || document.body.classList.contains('watching')) return;
    const page = window.innerWidth * 0.8;
    const step: Record<string, number> = {
      ArrowRight: 120, ArrowDown: 120, ArrowLeft: -120, ArrowUp: -120,
      PageDown: page, PageUp: -page, ' ': e.shiftKey ? -page : page,
    };
    if (e.key in step) moveTo(target + step[e.key]);
    else if (e.key === 'Home') moveTo(0);
    else if (e.key === 'End') moveTo(distance);
    else return;
    e.preventDefault();
  });

  // Touch screens wider than a phone (tablets): drag to slide.
  let touchX = 0;
  let touchY = 0;
  window.addEventListener('touchstart', (e) => {
    touchX = e.touches[0].clientX;
    touchY = e.touches[0].clientY;
  }, { passive: true });
  window.addEventListener('touchmove', (e) => {
    if (!desktop.matches) return;
    const t = e.touches[0];
    const dx = touchX - t.clientX;
    const dy = touchY - t.clientY;
    touchX = t.clientX;
    touchY = t.clientY;
    e.preventDefault();
    target = current = clamp(target + (Math.abs(dx) > Math.abs(dy) ? dx : dy));
    render();
  }, { passive: false });

  // Phone: the page scrolls normally; the blur follows the scroll.
  let ticking = false;
  const onScroll = () => {
    if (desktop.matches || ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      root.style.setProperty('--p', Math.min(1, window.scrollY / (window.innerHeight * 0.6)).toFixed(3));
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', measure);
  desktop.addEventListener('change', measure);
  document.querySelectorAll('.shot').forEach((img) => img.addEventListener('load', measure));
  window.addEventListener('load', measure);
  measure();

  // The "Play full" label replaces the mouse pointer over the thumbnail.
  const cursor = document.querySelector<HTMLElement>('.cursor');
  const playArea = document.querySelector<HTMLElement>('.play');
  if (cursor && playArea) {
    const follow = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      cursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
      cursor.classList.add('on');
    };
    playArea.addEventListener('pointerenter', follow);
    playArea.addEventListener('pointermove', follow);
    playArea.addEventListener('pointerleave', () => cursor.classList.remove('on'));
  }

  // "Play full" opens the Vimeo player over the whole window.
  const play = document.querySelector<HTMLButtonElement>('.play');
  const player = document.querySelector<HTMLElement>('.player');
  const close = () => {
    if (!player) return;
    player.querySelector('iframe')?.remove();
    player.hidden = true;
    document.body.classList.remove('watching');
  };
  play?.addEventListener('click', () => {
    if (!player) return;
    const iframe = document.createElement('iframe');
    iframe.src = play.dataset.embed ?? '';
    iframe.title = play.dataset.title ?? '';
    iframe.allow = 'autoplay; fullscreen; picture-in-picture';
    iframe.allowFullscreen = true;
    player.prepend(iframe);
    player.hidden = false;
    document.body.classList.add('watching');
    cursor?.classList.remove('on');
  });
  player?.querySelector('.close')?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>

<style>
  /*
   * Layers, back to front: the thumbnail (fixed), the stills (scroll), the
   * header and the info column (fixed). Sizes are design px on the 880px
   * canvas, like the rest of the site (see --rm in global.css).
   */
  :global(html) {
    --p: 0;
  }
  /* Desktop: the window doesn't scroll; the script slides the track instead. */
  :global(html.slide),
  :global(html.slide body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  .backdrop {
    position: fixed;
    inset: 0;
    background: #000;
    overflow: hidden;
    /* Slides left by up to 45% of the window as you scroll. */
    --bx: calc(var(--p) * -45vw);
  }
  /*
   * The thumbnail sits inside a transparent margin (--pad), and the blur is
   * applied to the whole box, so the image's edges fade softly into black.
   * Without the margin, Safari smears the edge pixels into streaks.
   * At the end of the scroll it is a 120 design px CSS blur, which looks like
   * a 240 blur in Figma (Figma's blur value is about twice the CSS one).
   */
  .thumb {
    --pad: calc(200 * var(--rm));
    position: absolute;
    inset: calc(var(--pad) * -1);
    padding: var(--pad);
    /* --pe reaches 1 after the first quarter of the scroll, so the blur and the
       step back ("behind the scenes") happen as soon as you start scrolling. */
    --pe: min(1, var(--p) * 4);
    transform: translateX(var(--bx)) scale(calc(1 - var(--pe) * 0.15));
    filter: blur(calc(var(--pe) * 120 * var(--rm))) brightness(calc(1 - var(--pe) * 0.1));
    will-change: transform, filter;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 3;
    padding-top: var(--top);
    color: #fff;
    /* All text is white with a difference blend, so it inverts over light areas. */
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .top :global(a) {
    pointer-events: auto;
  }
  /* Once you scroll, the header dims to 66%; hovering it brings it back. */
  .top :global(.header) {
    pointer-events: auto;
    opacity: calc(1 - 0.34 * min(1, var(--p) * 5));
    transition: opacity 0.2s;
  }
  .top :global(.header:hover) {
    opacity: 1;
  }

  /*
   * Left column (columns 1-6) with the about text and credits, and the
   * project list on the right (columns 19-24), both fixed to the window.
   * Both start at the same height, about a third of the way down.
   */
  .info {
    position: fixed;
    inset: 0;
    color: #fff;
    /* No z-index here or on .scroll: in Chrome, a z-index on either stops the
       difference blend from reaching the image. DOM order keeps this on top. */
    mix-blend-mode: difference;
    pointer-events: none;
    font-weight: 500;
    line-height: var(--line);
  }
  /*
   * Two rows: empty space under the header, then a row as tall as the project
   * list. The info on the left fills that second row, so it starts level with
   * the top of the list on first paint, with no script and no jump.
   */
  .info {
    grid-template-rows: minmax(calc(70 * var(--rm)), 1fr) minmax(0, max-content);
    padding-bottom: var(--margin);
  }
  /*
   * All text on this page: 8.2 design px with 9.4 line height, which is 13px
   * on 15px on alona's 14" MacBook, scaling with the window like the rest.
   */
  .top,
  .info {
    --text: calc(8.2 * var(--rm));
    --line: calc(9.4 * var(--rm));
    font-size: var(--text);
    line-height: var(--line);
  }
  .col {
    grid-row: 2;
    grid-column: 1 / 13;
    /* 252 design px: 400px on screen on alona's 14" MacBook. */
    width: calc(252 * var(--rm));
    display: flex;
    flex-direction: column;
    pointer-events: auto;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /*
   * The project list (src/components/ProjectList.astro, shared with the
   * homepage), anchored bottom right. It fades out in place during the first
   * fifth of the scroll.
   */
  .info :global(.list) {
    grid-row: 2;
    grid-column: 13 / -1;
    justify-self: end;
    pointer-events: auto;
    opacity: calc(1 - min(1, var(--p) * 5));
  }
  :global(html.list-gone) .info :global(.list) {
    pointer-events: none;
  }
  .list a:hover,
  .list a:focus-visible {
    color: var(--hover);
    outline: none;
  }

  .col p {
    margin: 0;
  }
  .about .text {
    margin-top: calc(50 * var(--rm));
    font-weight: 400;
    text-align: justify;
    hyphens: manual;
  }
  .about .todo {
    margin-top: var(--row);
  }
  .credits {
    margin: auto 0 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 1em;
    margin-bottom: calc(var(--row) * 0.45);
  }
  .row:last-child {
    margin-bottom: 0;
  }
  dt,
  dd {
    margin: 0;
  }
  dd {
    text-align: right;
    max-width: 62%;
  }

  .scroll {
    position: relative;
  }

  /* The window-sized stage that holds the sliding track. */
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .track {
    display: flex;
    height: 100%;
    width: max-content;
    will-change: transform;
  }

  /*
   * First screen: the whole thumbnail is the play button. With a mouse, the
   * pointer becomes the "Play full" label (.cursor); on touch screens the
   * label sits in the middle instead.
   */
  .hero {
    width: 100vw;
    height: 100%;
  }
  .play {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  /* The label: a light box, 56 x 24 px, with 14 px text. */
  .play-label {
    display: grid;
    place-items: center;
    width: 56px;
    height: 24px;
    background: #e8e8e8;
    color: #000;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1;
    font-weight: 400;
    white-space: nowrap;
  }
  .play .play-label {
    opacity: calc(1 - var(--p) * 4);
  }
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 15;
    pointer-events: none;
    display: none;
    /* Fades as the thumbnail slides away. */
    opacity: calc(1 - var(--p) * 4);
  }
  .cursor .play-label {
    /* Centred on the pointer. */
    translate: -50% -50%;
  }
  @media (hover: hover) and (pointer: fine) {
    .play {
      cursor: none;
    }
    .play .play-label {
      visibility: hidden;
    }
    .cursor.on {
      display: block;
    }
  }

  /*
   * Phone fallback base for the stills (the desktop row is below).
   */
  .shots {
    width: 100vw;
    height: 100%;
    align-content: end;
    row-gap: calc(80 * var(--rm));
    padding-bottom: calc(26 * var(--rm));
  }
  .shot {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    background: #111;
  }
  .shot:nth-child(odd) {
    grid-column: 11 / 17;
  }
  .shot:nth-child(even) {
    grid-column: 19 / -1;
  }
  /*
   * Desktop: the stills sit in one row instead and slide in one by one as
   * you scroll. Each is as tall as the info column on the left (from "about
   * film" to the last credit) and starts level with it; the script measures
   * the column into --shots-top and --shots-h. 55 design px between them.
   */
  @media (min-width: 768px) {
    .shots {
      display: flex;
      align-items: flex-start;
      gap: calc(55 * var(--rm));
      width: auto;
      padding: var(--shots-top, 45svh) var(--margin) 0 0;
    }
    .shot {
      flex: none;
      /* Width set outright (16:9), not left to the image: Safari can lay a
         not-yet-loaded image out at zero width, leaving nothing to scroll. */
      height: var(--shots-h, calc(106 * var(--rm)));
      width: calc(var(--shots-h, calc(106 * var(--rm))) * 16 / 9);
    }
  }

  /* The film, over everything. */
  .player {
    position: fixed;
    inset: 0;
    z-index: 20;
    background: #000;
  }
  .player[hidden] {
    display: none;
  }
  .player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .close {
    position: absolute;
    top: var(--top);
    right: var(--margin);
    z-index: 1;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  :global(body.watching) {
    overflow: hidden;
  }

  /*
   * Phone: there's no room for a column over the image, so the info moves
   * into the page under the first screen, followed by the stills.
   */
  @media (max-width: 767px) {
    /* Phones keep the site's usual phone sizes. */
    .top,
    .info {
      --text: 12px;
      --line: calc(10.6 * var(--rm));
    }
    .info {
      position: relative;
      inset: auto;
      z-index: 1;
      pointer-events: auto;
      grid-template-rows: none;
      padding-bottom: 0;
    }
    .info :global(.list) {
      display: none;
    }
    .col {
      grid-row: auto;
      grid-column: 1 / -1;
      height: auto;
      width: auto;
      padding-block: 0 calc(var(--row) * 2);
    }
    .about,
    .about .text {
      margin-top: var(--row);
    }
    .credits {
      margin-top: calc(var(--row) * 2);
    }
    /* Phone: an ordinary vertical page: first screen, info, then stills. */
    .scroll {
      display: flex;
      flex-direction: column;
    }
    .stage,
    .track {
      display: contents;
    }
    .hero {
      width: auto;
      height: 62svh;
    }
    .info {
      order: 1;
    }
    .shots {
      order: 2;
      width: auto;
      height: auto;
      row-gap: 8px;
      padding-bottom: calc(var(--row) * 2);
    }
    .shot:nth-child(n) {
      grid-column: 1 / -1;
    }
  }
</style>
