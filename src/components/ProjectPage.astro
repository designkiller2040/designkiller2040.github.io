---
/*
 * Project page layout, used by every project (src/pages/work/[slug].astro).
 *
 * The film's thumbnail fills the whole window and stays put. The title, about
 * text and credits sit fixed on the right, over the image. As you scroll, the
 * thumbnail blurs and the page slides sideways to show the stills on the right.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import { CREDIT_ORDER, posterSrc, stillSrcs, type Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const credits = CREDIT_ORDER.filter((l) => project.credits[l]).map((l) => ({
  label: l.toLowerCase(),
  value: project.credits[l]!,
}));
const embed = `https://player.vimeo.com/video/${project.vimeo}?dnt=1&title=0&byline=0&portrait=0&autoplay=1`;
const poster = posterSrc(project);
---

<Base title={project.title} theme="dark">
  <link slot="head" rel="preload" href={poster} as="image" />

  <!-- The thumbnail. As you scroll it slides left and the blur builds up. -->
  <div class="backdrop" aria-hidden="true">
    <div class="thumb"><img src={poster} alt="" /></div>
  </div>

  <div class="top grid">
    <Header current="works" />
  </div>

  <main class="scroll">
    <!-- Desktop: the page scrolls sideways. The stage stays in the window
         while the track slides left as you scroll. -->
    <div class="stage">
      <div class="track">
        <div class="hero">
          <button class="play" type="button" data-embed={embed} data-title={project.title}>
            <span class="play-label">Play full</span>
          </button>
        </div>

        <div class="shots grid">
          {stillSrcs(project).map((src) => <img class="shot" src={src} alt="" />)}
        </div>
      </div>
    </div>

    <aside class="info grid">
      <div class="col">
        <div class="titlebar">
          <a class="back" href="/" aria-label="Back to all works">&lt;</a>
          <h1>{project.title}</h1>
        </div>
        <div class="about">
          <p class="label">about film:</p>
          {project.about && <p class="text">{project.about}</p>}
          {project.todo && <p class="todo">TODO: {project.todo}</p>}
        </div>
        <dl class="credits">
          {
            credits.map((r) => (
              <div class="row">
                <dt>{r.label}:</dt>
                <dd>{r.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </aside>
  </main>

  <!-- With a mouse, "Play full" follows the pointer over the thumbnail. -->
  <div class="cursor" aria-hidden="true"><span class="play-label">Play full</span></div>

  <div class="player" hidden>
    <button class="close" type="button" aria-label="Close film">close</button>
  </div>
</Base>

<script>
  const root = document.documentElement;

  // Desktop: the page itself doesn't scroll. The mouse wheel, trackpad,
  // arrow keys and touch move the track sideways instead, eased so it glides.
  // (Driving it from the page's own scroll made browsers bounce at the end
  // and reopen the page halfway through.)
  const desktop = window.matchMedia('(min-width: 768px)');
  const track = document.querySelector<HTMLElement>('.track');
  const info = document.querySelector<HTMLElement>('.info');
  const col = document.querySelector<HTMLElement>('.info .col');
  let distance = 0; // how far the track can slide, in px
  let target = 0; // where it's heading
  let current = 0; // where it is now
  let frame = 0;

  const clamp = (v: number) => Math.min(distance, Math.max(0, v));

  const render = () => {
    if (!track) return;
    track.style.transform = `translate3d(${-current}px, 0, 0)`;
    // Progress: 0 at the start, 1 at the end of the slide.
    root.style.setProperty('--p', distance ? (current / distance).toFixed(4) : '0');
  };

  const tick = () => {
    current += (target - current) * 0.14;
    if (Math.abs(target - current) < 0.5) current = target;
    render();
    frame = current === target ? 0 : requestAnimationFrame(tick);
  };
  const moveTo = (v: number) => {
    target = clamp(v);
    if (!frame) frame = requestAnimationFrame(tick);
  };

  const measure = () => {
    if (!track) return;
    if (desktop.matches) {
      root.classList.add('slide');
      distance = Math.max(0, track.scrollWidth - window.innerWidth);
      // How far the info column travels to reach the left margin.
      if (info && col) {
        const shift = col.offsetLeft - parseFloat(getComputedStyle(info).paddingLeft);
        root.style.setProperty('--shift', `${shift}px`);
      }
      // Keep the same progress through the slide when the window resizes.
      const ratio = target && distance ? target / distance : 0;
      target = current = clamp(ratio * distance);
      render();
    } else {
      root.classList.remove('slide');
      distance = target = current = 0;
      track.style.transform = '';
      onScroll();
    }
  };

  window.addEventListener(
    'wheel',
    (e) => {
      if (!desktop.matches || document.body.classList.contains('watching')) return;
      e.preventDefault();
      const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerHeight : 1;
      const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      moveTo(target + d * unit);
    },
    { passive: false },
  );

  document.addEventListener('keydown', (e) => {
    if (!desktop.matches || document.body.classList.contains('watching')) return;
    const page = window.innerWidth * 0.8;
    const step: Record<string, number> = {
      ArrowRight: 120, ArrowDown: 120, ArrowLeft: -120, ArrowUp: -120,
      PageDown: page, PageUp: -page, ' ': e.shiftKey ? -page : page,
    };
    if (e.key in step) moveTo(target + step[e.key]);
    else if (e.key === 'Home') moveTo(0);
    else if (e.key === 'End') moveTo(distance);
    else return;
    e.preventDefault();
  });

  // Touch screens wider than a phone (tablets): drag to slide.
  let touchX = 0;
  let touchY = 0;
  window.addEventListener('touchstart', (e) => {
    touchX = e.touches[0].clientX;
    touchY = e.touches[0].clientY;
  }, { passive: true });
  window.addEventListener('touchmove', (e) => {
    if (!desktop.matches) return;
    const t = e.touches[0];
    const dx = touchX - t.clientX;
    const dy = touchY - t.clientY;
    touchX = t.clientX;
    touchY = t.clientY;
    e.preventDefault();
    target = current = clamp(target + (Math.abs(dx) > Math.abs(dy) ? dx : dy));
    render();
  }, { passive: false });

  // Phone: the page scrolls normally; the blur follows the scroll.
  let ticking = false;
  const onScroll = () => {
    if (desktop.matches || ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      root.style.setProperty('--p', Math.min(1, window.scrollY / (window.innerHeight * 0.6)).toFixed(3));
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', measure);
  desktop.addEventListener('change', measure);
  document.querySelectorAll('.shot').forEach((img) => img.addEventListener('load', measure));
  measure();

  // The "Play full" label replaces the mouse pointer over the thumbnail.
  const cursor = document.querySelector<HTMLElement>('.cursor');
  const playArea = document.querySelector<HTMLElement>('.play');
  if (cursor && playArea) {
    const follow = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      cursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
      cursor.classList.add('on');
    };
    playArea.addEventListener('pointerenter', follow);
    playArea.addEventListener('pointermove', follow);
    playArea.addEventListener('pointerleave', () => cursor.classList.remove('on'));
  }

  // "Play full" opens the Vimeo player over the whole window.
  const play = document.querySelector<HTMLButtonElement>('.play');
  const player = document.querySelector<HTMLElement>('.player');
  const close = () => {
    if (!player) return;
    player.querySelector('iframe')?.remove();
    player.hidden = true;
    document.body.classList.remove('watching');
  };
  play?.addEventListener('click', () => {
    if (!player) return;
    const iframe = document.createElement('iframe');
    iframe.src = play.dataset.embed ?? '';
    iframe.title = play.dataset.title ?? '';
    iframe.allow = 'autoplay; fullscreen; picture-in-picture';
    iframe.allowFullscreen = true;
    player.prepend(iframe);
    player.hidden = false;
    document.body.classList.add('watching');
    cursor?.classList.remove('on');
  });
  player?.querySelector('.close')?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>

<style>
  /*
   * Layers, back to front: the thumbnail (fixed), the stills (scroll), the
   * header and the info column (fixed). Sizes are design px on the 880px
   * canvas, like the rest of the site (see --rm in global.css).
   */
  :global(html) {
    --p: 0;
  }
  /* Desktop: the window doesn't scroll; the script slides the track instead. */
  :global(html.slide),
  :global(html.slide body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  .backdrop {
    position: fixed;
    inset: 0;
    background: #000;
    overflow: hidden;
    /* Slides left by up to 45% of the window as you scroll. */
    --bx: calc(var(--p) * -45vw);
  }
  /*
   * The thumbnail sits inside a transparent margin (--pad), and the blur is
   * applied to the whole box, so the image's edges fade softly into black.
   * Without the margin, Safari smears the edge pixels into streaks.
   * At the end of the scroll it is a 120 design px CSS blur, which looks like
   * a 240 blur in Figma (Figma's blur value is about twice the CSS one).
   */
  .thumb {
    --pad: calc(200 * var(--rm));
    position: absolute;
    inset: calc(var(--pad) * -1);
    padding: var(--pad);
    transform: translateX(var(--bx));
    filter: blur(calc(var(--p) * 120 * var(--rm))) brightness(calc(1 - var(--p) * 0.1));
    will-change: transform, filter;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 3;
    padding-top: var(--top);
    color: #fff;
    pointer-events: none;
  }
  .top :global(a) {
    pointer-events: auto;
  }

  /* Right-hand column (columns 19-24), fixed to the window. */
  .info {
    position: fixed;
    inset: 0;
    z-index: 2;
    color: #fff;
    pointer-events: none;
    font-weight: 500;
    line-height: var(--line);
  }
  .col {
    grid-column: 19 / -1;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-block: calc(92 * var(--rm)) var(--margin);
    pointer-events: auto;
    /* Slides from the right-hand columns to the left margin as you scroll. */
    transform: translateX(calc(var(--p) * var(--shift, 0px) * -1));
  }
  .col p {
    margin: 0;
  }
  .titlebar {
    display: flex;
    align-items: baseline;
    gap: calc(21 * var(--rm));
    font-size: var(--title);
    line-height: 1.2;
  }
  .titlebar h1 {
    margin: 0;
    font-size: inherit;
    font-weight: 500;
  }
  .about {
    margin-top: calc(56 * var(--rm));
  }
  .about .text {
    margin-top: calc(40 * var(--rm));
    text-align: justify;
    hyphens: manual;
  }
  .about .todo {
    margin-top: var(--row);
  }
  .credits {
    margin: auto 0 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 1em;
    margin-bottom: calc(var(--row) * 0.45);
  }
  .row:last-child {
    margin-bottom: 0;
  }
  dt,
  dd {
    margin: 0;
  }
  dd {
    text-align: right;
    max-width: 62%;
  }
  .back:hover {
    color: var(--hover);
  }

  .scroll {
    position: relative;
    z-index: 1;
  }

  /* The window-sized stage that holds the sliding track. */
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .track {
    display: flex;
    height: 100%;
    width: max-content;
    will-change: transform;
  }

  /*
   * First screen: the whole thumbnail is the play button. With a mouse, the
   * pointer becomes the "Play full" label (.cursor); on touch screens the
   * label sits in the middle instead.
   */
  .hero {
    width: 100vw;
    height: 100%;
  }
  .play {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  /* The label: a light box, 56 x 24 px, with 14 px text. */
  .play-label {
    display: grid;
    place-items: center;
    width: 56px;
    height: 24px;
    background: #e8e8e8;
    color: #000;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1;
    font-weight: 400;
    white-space: nowrap;
  }
  .play .play-label {
    opacity: calc(1 - var(--p) * 4);
  }
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 15;
    pointer-events: none;
    display: none;
    /* Fades as the thumbnail slides away. */
    opacity: calc(1 - var(--p) * 4);
  }
  .cursor .play-label {
    /* Centred on the pointer. */
    translate: -50% -50%;
  }
  @media (hover: hover) and (pointer: fine) {
    .play {
      cursor: none;
    }
    .play .play-label {
      visibility: hidden;
    }
    .cursor.on {
      display: block;
    }
  }

  /*
   * Second screen: the stills in a 2x2 grid on the right (columns 11-16 and
   * 19-24), sitting low in the window.
   */
  .shots {
    width: 100vw;
    height: 100%;
    align-content: end;
    row-gap: calc(80 * var(--rm));
    padding-bottom: calc(26 * var(--rm));
  }
  .shot {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    background: #111;
  }
  .shot:nth-child(odd) {
    grid-column: 11 / 17;
  }
  .shot:nth-child(even) {
    grid-column: 19 / -1;
  }

  /* The film, over everything. */
  .player {
    position: fixed;
    inset: 0;
    z-index: 20;
    background: #000;
  }
  .player[hidden] {
    display: none;
  }
  .player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .close {
    position: absolute;
    top: var(--top);
    right: var(--margin);
    z-index: 1;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  :global(body.watching) {
    overflow: hidden;
  }

  /*
   * Phone: there's no room for a column over the image, so the info moves
   * into the page under the first screen, followed by the stills.
   */
  @media (max-width: 767px) {
    .info {
      position: relative;
      inset: auto;
      z-index: 1;
      pointer-events: auto;
    }
    .col {
      grid-column: 1 / -1;
      height: auto;
      padding-block: 0 calc(var(--row) * 2);
    }
    .about,
    .about .text {
      margin-top: var(--row);
    }
    .credits {
      margin-top: calc(var(--row) * 2);
    }
    /* Phone: an ordinary vertical page: first screen, info, then stills. */
    .scroll {
      display: flex;
      flex-direction: column;
    }
    .stage,
    .track {
      display: contents;
    }
    .hero {
      width: auto;
      height: 62svh;
    }
    .info {
      order: 1;
    }
    .shots {
      order: 2;
      width: auto;
      height: auto;
      row-gap: 8px;
      padding-bottom: calc(var(--row) * 2);
    }
    .shot:nth-child(n) {
      grid-column: 1 / -1;
    }
    .col {
      transform: none;
    }
  }
</style>
