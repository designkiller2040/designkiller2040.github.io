---
/** Legal links at the bottom of the About page (only there). Sits inside a .grid, full width. */
---

<footer class="legal">
  <a href="/legal/">legal x privacy</a>
</footer>

<style>
  .legal {
    grid-column: 1 / -1;
    display: flex;
    gap: calc(22 * var(--rm));
    margin-top: calc(28 * var(--rm));
    position: relative;
    /* 2026-10-29: small and grey, and only on the About page. */
    font-size: max(11px, calc(7 * var(--rm)));
    color: #8a8a8a;
  }
  .legal a:hover {
    color: var(--hover);
  }
</style>
