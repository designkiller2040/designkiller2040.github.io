---
interface Props {
  /** Which nav link is underlined. */
  current?: 'works' | 'about' | 'contact';
}
const { current } = Astro.props;
const links = [
  { key: 'works', label: 'all works', href: '/' },
  { key: 'about', label: 'about', href: '/about/' },
  { key: 'contact', label: 'contact', href: '/contact/' },
] as const;
---

<header class="header">
  <a class="logo" href="/" aria-label="Jonah George"><span class="logo-mark"></span></a>
  <nav class="nav" aria-label="Main">
    {
      links.map((l) => (
        <a class:list={{ u: current === l.key }} href={l.href} aria-current={current === l.key ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <span class="insta">
    instagram: <a class="u" href="https://www.instagram.com/jonahgeorge/" target="_blank" rel="noopener">@jonahgeorge</a>
  </span>
</header>
<div class="header-band" aria-hidden="true"></div>

<style>
  /*
   * The header spans the page's 24-column grid (it must sit inside a .grid).
   * Desktop and tablet: nav on the left | logo centred (columns 9-16, the
   * middle third) | instagram on the right. Phone: logo centred on its own
   * row, nav and instagram below.
   */
  .header {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    /*
     * 2026-10-29: the menu stays on screen while the page scrolls, on every
     * page. It starts where it always was and sticks there, so nothing is
     * hidden under it. z-index above the band below and the contact page's text.
     */
    position: sticky;
    top: var(--top);
    z-index: 100002;
    white-space: nowrap;
    /* Fixed here, not inherited, so the header is identical on every page. */
    font-family: var(--font-sans);
    /* 8.83 design px on 10.05: 14px on 16px on a 14" MacBook (see global.css). */
    font-size: calc(8.83 * var(--rm));
    line-height: calc(10.05 * var(--rm));
    --tracking: -0.06em;
  }
  /*
   * The logo (public/images/logo.svg) is drawn as a mask filled with the
   * text colour, so it is white or black like the rest of the header and
   * takes the difference blend with it. It lines up with the nav text on the
   * baseline of its lowercase letters (59% down the artwork): a negative
   * bottom margin puts the logo's baseline there, and the header's bottom
   * padding makes room for the descenders below it.
   */
  .header {
    --logo-w: calc(112 * var(--rm));
    --logo-h: calc(var(--logo-w) * 65 / 192);
    padding-bottom: calc(var(--logo-h) * 0.41);
  }
  /*
   * Once the page is scrolled, a band behind the menu (from the top of the
   * screen to just below it) hides the text scrolling underneath: white on
   * white pages; on dark ones (Legal's video, project pages on phones) a
   * dark blur, like frosted glass. Its lower edge fades out. At the top of
   * the page it's invisible, so nothing changes there. It's a separate
   * element so the blur can see the page behind it.
   */
  .header-band {
    position: fixed;
    inset: 0 0 auto;
    height: calc(var(--header-bottom, 100px) + 2 * var(--top));
    z-index: 100000;
    pointer-events: none;
    background: #fff;
    -webkit-mask: linear-gradient(#000 50%, transparent);
    mask: linear-gradient(#000 50%, transparent);
    opacity: 0;
    transition: opacity 0.2s;
  }
  :global(body.dark) .header-band {
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  :global(html.scrolled) .header-band {
    opacity: 1;
  }

  .logo {
    grid-row: 1;
    grid-column: 9 / 17;
    justify-self: center;
    line-height: 0;
  }
  .logo-mark {
    display: inline-block;
    width: var(--logo-w);
    height: var(--logo-h);
    margin-bottom: calc(var(--logo-h) * -0.41);
    background: currentColor;
    -webkit-mask: url(/images/logo.svg) center / 100% 100% no-repeat;
    mask: url(/images/logo.svg) center / 100% 100% no-repeat;
  }
  /* 2026-10-11: logo nudged 5px down on alona's MacBook (3.1 design px),
     without moving the nav. A translate doesn't change the layout. */
  @media (min-width: 768px) {
    .logo-mark {
      translate: 0 calc(3.1 * var(--rm));
    }
  }
  .nav {
    grid-row: 1;
    grid-column: 1 / 9;
    display: flex;
    gap: calc(66 * var(--rm));
  }
  .insta {
    grid-row: 1;
    grid-column: 17 / -1;
    justify-self: end;
  }
  .nav a:hover,
  .insta a:hover {
    color: var(--hover);
  }

  @media (max-width: 767px) {
    .header {
      row-gap: 10px;
      /* Phones keep 10px: the desktop size would be too small to read. */
      font-size: 10px;
      line-height: 12px;
    }
    .logo {
      grid-column: 1 / -1;
    }
    .nav,
    .insta {
      grid-row: 2;
    }
    .logo-mark {
      margin-bottom: 0;
    }
    .nav {
      grid-column: 1 / 13;
      gap: 0.9em; /* 6.6em doesn't fit beside instagram on a phone */
    }
    .insta {
      grid-column: 13 / -1;
    }
  }
</style>

<script>
  // Shows the band behind the menu once the page has been scrolled, and
  // keeps it as tall as the menu (which is taller on phones).
  const html = document.documentElement;
  const header = document.querySelector<HTMLElement>('.header');
  const scrolled = () => html.classList.toggle('scrolled', scrollY > 0);
  scrolled();
  addEventListener('scroll', scrolled, { passive: true });
  if (header) {
    const measure = () => html.style.setProperty('--header-bottom', `${header.getBoundingClientRect().bottom}px`);
    measure();
    new ResizeObserver(measure).observe(header);
  }
</script>
