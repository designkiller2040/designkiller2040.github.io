---
interface Props {
  /** Which nav link is underlined. */
  current?: 'works' | 'about' | 'contact';
}
const { current } = Astro.props;
const links = [
  { key: 'works', label: 'all works', href: '/' },
  { key: 'about', label: 'about', href: '/about/' },
  { key: 'contact', label: 'contact', href: '/contact/' },
] as const;
---

<header class="header">
  <a class="logo" href="/" aria-label="Jonah George"><span class="logo-mark"></span></a>
  <nav class="nav" aria-label="Main">
    {
      links.map((l) => (
        <a class:list={{ u: current === l.key }} href={l.href} aria-current={current === l.key ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <span class="insta">
    <span class="ig-long">instagram: </span><span class="ig-short">ig: </span><a class="u" href="https://www.instagram.com/jonahgeorge/" target="_blank" rel="noopener"><span class="at">@</span>jonahgeorge</a>
  </span>
</header>

<style>
  /*
   * The header spans the page's 24-column grid (it must sit inside a .grid).
   * Desktop and tablet: nav on the left | logo centred (columns 9-16, the
   * middle third) | instagram on the right. Phone: logo centred on its own
   * row, nav and instagram below.
   */
  .header {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    /*
     * 2026-10-29: the menu stays on screen while the page scrolls, on every
     * page. It starts where it always was and sticks there, so nothing is
     * hidden under it. z-index above the contact page's text.
     */
    position: sticky;
    top: var(--top);
    z-index: 100002;
    white-space: nowrap;
    /* Fixed here, not inherited, so the header is identical on every page. */
    font-family: var(--font-sans);
    /* 8.83 design px on 10.05: 14px on 16px on a 14" MacBook (see global.css). */
    font-size: calc(8.83 * var(--rm));
    line-height: calc(10.05 * var(--rm));
    --tracking: -0.06em;
  }
  /*
   * The logo (public/images/logo.svg) is drawn as a mask filled with the
   * text colour, so it is white or black like the rest of the header and
   * takes the difference blend with it. It lines up with the nav text on the
   * baseline of its lowercase letters (59% down the artwork): a negative
   * bottom margin puts the logo's baseline there, and the header's bottom
   * padding makes room for the descenders below it.
   */
  .header {
    --logo-w: calc(112 * var(--rm));
    --logo-h: calc(var(--logo-w) * 65 / 192);
    padding-bottom: calc(var(--logo-h) * 0.41);
  }
  /*
   * 2026-10-29: white with a difference blend on every page (black on white
   * pages, white on dark ones), so it stays readable over whatever scrolls
   * under it. Project pages keep plain white (ProjectPage.astro).
   */
  .header {
    color: #fff;
    mix-blend-mode: difference;
  }

  .logo {
    grid-row: 1;
    grid-column: 9 / 17;
    justify-self: center;
    line-height: 0;
  }
  .logo-mark {
    display: inline-block;
    width: var(--logo-w);
    height: var(--logo-h);
    margin-bottom: calc(var(--logo-h) * -0.41);
    background: currentColor;
    -webkit-mask: url(/images/logo.svg) center / 100% 100% no-repeat;
    mask: url(/images/logo.svg) center / 100% 100% no-repeat;
  }
  /* 2026-10-11: logo nudged 5px down on alona's MacBook (3.1 design px),
     without moving the nav. A translate doesn't change the layout. */
  @media (min-width: 768px) {
    .logo-mark {
      translate: 0 calc(3.1 * var(--rm));
    }
  }
  .nav {
    grid-row: 1;
    grid-column: 1 / 9;
    display: flex;
    gap: calc(66 * var(--rm));
  }
  .insta {
    grid-row: 1;
    grid-column: 17 / -1;
    justify-self: end;
  }
  .ig-short {
    display: none;
  }
  .nav a:hover,
  .insta a:hover {
    color: var(--hover);
  }

  @media (max-width: 767px) {
    .header {
      /* 2026-10-29: the logo is twice its desktop design size on phones. */
      --logo-w: 180px;
      --logo-h: calc(180px * 65 / 192);
      row-gap: 12px;
      /* 2026-10-29: a white bar 32px tall across the top with the menu in
         black, and the logo (180px wide) sits below it over the page. */
      position: sticky;
      top: 0;
      margin-top: calc(-1 * var(--top));
      padding-bottom: 0;
      color: #000;
      mix-blend-mode: normal;
      align-items: center;
      /* The text is centred in the 32px bar. */
      line-height: 32px;
    }
    .header::before {
      content: '';
      position: absolute;
      z-index: -1;
      top: 0;
      left: 50%;
      width: 100vw;
      height: 32px;
      translate: -50% 0;
      background: #fff;
    }
    .logo {
      grid-row: 2;
    }
    /* Phones: "ig: jonahgeorge". */
    .ig-long,
    .at {
      display: none;
    }
    .ig-short {
      display: inline;
    }
    .nav,
    .insta {
      grid-row: 1;
    }
    .header {
      /* Phones: 14px, the same as the project list, project info and
         Contact (2026-10-29). */
      font-size: 14px;
    }
    .logo {
      grid-column: 1 / -1;
    }
    .logo-mark {
      margin-bottom: 0;
    }
    .nav {
      grid-column: 1 / 13;
      gap: 0.9em; /* 6.6em doesn't fit beside instagram on a phone */
    }
    .insta {
      grid-column: 13 / -1;
    }
    /* 2026-10-29: the menu fades out while you scroll down and comes back
       as soon as you scroll up (script below). */
    .header {
      transition: opacity 0.3s ease;
    }
    :global(html.header-hidden) .header {
      opacity: 0 !important; /* beats the project page's own dimming */
      pointer-events: none;
    }
  }
</style>

<script>
  // Phones (CSS above): hide the menu on scroll down, show it on scroll up.
  let lastY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      if (Math.abs(y - lastY) < 6) return;
      document.documentElement.classList.toggle('header-hidden', y > lastY && y > 60);
      lastY = y;
    },
    { passive: true },
  );
</script>

