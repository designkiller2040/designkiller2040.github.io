---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** dark = black page with white text (homepage). */
  theme?: 'dark' | 'light';
}
const { title, description = 'Jonah George, director.', theme = 'light' } = Astro.props;
const fullTitle = title ? `${title} | Jonah George` : 'Jonah George';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Page transitions (global.css). To or from the homepage, the header
         and list are left in the page-wide crossfade, so they change
         between the homepage's difference blend and plain white in place. -->
    <!-- The homepage's loader (index.astro) plays once per visit: the first
         page opened in a tab marks the visit, so later visits to the
         homepage in that tab skip it. ?loader on the homepage forces it. -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        try {
          if (sessionStorage.getItem('jg-visit') && !/[?&]loader/.test(location.search)) html.classList.add('visited');
          sessionStorage.setItem('jg-visit', '1');
        } catch (e) { html.classList.add('visited'); }
      })();
    </script>
    <script is:inline>
      (function () {
        var html = document.documentElement;
        function path(u) { try { return new URL(u).pathname; } catch (e) { return ''; } }
        addEventListener('pageswap', function (e) {
          if (e.viewTransition && (location.pathname === '/' || path(e.activation && e.activation.entry.url) === '/')) html.classList.add('vt-home');
        });
        addEventListener('pageshow', function () { html.classList.remove('vt-home'); });
        addEventListener('pagereveal', function (e) {
          if (!e.viewTransition) return;
          var from = window.navigation && navigation.activation && navigation.activation.from;
          if (location.pathname !== '/' && path(from && from.url) !== '/') return;
          html.classList.add('vt-home');
          e.viewTransition.finished.finally(function () { html.classList.remove('vt-home'); });
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={theme}>
    <slot />
  </body>
</html>

<style is:global>
  html:has(body.dark),
  body.dark {
    background: #000;
    color: #fff;
  }
</style>
